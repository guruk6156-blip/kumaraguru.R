    "group-esp32-devkit-c-v4": [
      {
        "name": "sketch.ino",
        "content": "void setup() {\n  pinMode(25, OUTPUT);\n  pinMode(26, OUTPUT);\n  pinMode(27, OUTPUT);\n\n\n  \n}\n\nvoid loop() {\n\n \n  digitalWrite(25, HIGH);\n  digitalWrite(26, LOW);\n  digitalWrite(27, LOW);\n  delay(5000);\n\n  \n  digitalWrite(25, LOW);\n  digitalWrite(26, HIGH);\n  digitalWrite(27, LOW);\n  delay(1500);\n\n  \n  digitalWrite(25, LOW);\n  digitalWrite(26, LOW);\n  digitalWrite(27, HIGH);\n  delay(6000);\n}\n"
      }
    ]
  },
